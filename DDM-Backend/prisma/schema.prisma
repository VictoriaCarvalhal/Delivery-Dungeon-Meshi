// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model Prato{
  id_prato Int @id @default(autoincrement())
  nome String @unique
  desc String
  valor_unit Float

  pedidos  Pedido[] 

  @@index([id_prato])
}

model Pedido{
  id_pedido Int @id @default(autoincrement())
  id_prato Int
  id_carrinho Int
  quant Int

  prato Prato @relation(fields: [id_prato], references: [id_prato], onDelete: Cascade, onUpdate: Cascade)

  carrinho Carrinho @relation(fields: [id_carrinho], references: [id_carrinho],onDelete: Cascade, onUpdate: Cascade )

  @@unique([id_prato, id_carrinho])
  @@index([id_pedido])

}

model Carrinho{
  id_carrinho Int @id @default(autoincrement())

  pedido Pedido[]

  @@index([id_carrinho])
}
