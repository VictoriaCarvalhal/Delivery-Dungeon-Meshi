# ============================================
# Delivery Dungeon Meshi - Backend
# ============================================
# Copie este arquivo para .env antes de rodar:
#   cp .env.example .env
#
# Os valores abaixo já funcionam para desenvolvimento local
# com o docker-compose.yml do projeto.
# Em produção, configure as variáveis pelo seu provedor (Railway, Render, etc.)
# ============================================

# Porta em que a API vai rodar
PORT=3000

# Ambiente de execução (development | production)
NODE_ENV=development

# URL onde o frontend está rodando
FRONTEND_URL=http://localhost:5175

# URL de conexão com o PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://ddm_user:ddm_pass@localhost:5432/ddm_database
